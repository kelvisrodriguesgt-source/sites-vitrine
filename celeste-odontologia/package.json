{
  "name": "celeste-odontologia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site demonstrativo de clínica odontológica premium (React + TypeScript + Tailwind), personalizável por src/config/site.ts",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/prepare-admin.mjs && vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/prepare-admin.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "qa": "node scripts/qa.mjs",
    "prepare:admin": "node scripts/prepare-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "decap-cms": "^3.17.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.9"
  }
}
